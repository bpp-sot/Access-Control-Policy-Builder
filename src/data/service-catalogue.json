  "azureServices": [
    {
      "id": "azure-compute-vm",
      "name": "Virtual Machines",
      "category": "Compute",
      "resourceTypes": [
        "Microsoft.Compute/virtualMachines",
        "Microsoft.Compute/disks",
        "Microsoft.Compute/virtualMachines/extensions"
      ],
      "officialSampleAvailable": true,
      "officialSampleIds": [
        "azure-block-all-vms",
        "azure-block-by-type-partial",
        "azure-full-lockdown-type-name-sku",
        "azure-block-specific-vm-sizes",
        "azure-limit-vm-vmss-name-sku-region-capacity",
        "azure-limit-vm-name-size-location",
        "azure-limit-vm-sizes",
        "azure-require-resource-name"
      ],
      "riskCategory": "High",
      "costSensitivity": "High",
      "identitySensitivity": "Medium",
      "networkExposureSensitivity": "Medium",
      "notes": "VMs are the most abused resource by malicious users (e.g. bitcoin miners). Limit by SKU, Region, and Name for maximum security.",
      "dependencies": [
        {
          "serviceId": "azure-compute-vm",
          "serviceName": "Managed Disks",
          "resourceTypes": ["Microsoft.Compute/disks"],
          "reason": "Azure automatically creates an OS managed disk (Microsoft.Compute/disks) when provisioning a standard VM. Without this resource type in the policy whitelist, VM deployment will fail even though the VM resource type itself is permitted. This is native Azure platform behaviour, not a Skillable-specific rule.",
          "required": true,
          "autoIncluded": true,
          "evidenceClassification": "C"
        },
        {
          "serviceId": "azure-compute-vm",
          "serviceName": "VM Extensions",
          "resourceTypes": ["Microsoft.Compute/virtualMachines/extensions"],
          "reason": "VM extensions (e.g. custom script, domain join, monitoring agent) are deployed as child resources of the VM. They are NOT required for basic VM deployment — only opt in if the lab uses extensions for post-deployment configuration. Opting in adds Microsoft.Compute/virtualMachines/extensions to the policy whitelist.",
          "required": false,
          "autoIncluded": false,
          "evidenceClassification": "C"
        },
        {
          "serviceId": "azure-networking",
          "serviceName": "Networking",
          "resourceTypes": [
            "Microsoft.Network/virtualNetworks",
            "Microsoft.Network/networkInterfaces",
            "Microsoft.Network/networkSecurityGroups"
          ],
          "reason": "Azure VMs require a network interface (NIC), which in turn requires a virtual network (VNet) and typically a network security group (NSG). Without these, VM deployment will fail. All official Skillable VM samples include Microsoft.Network resources as supporting infrastructure.",
          "required": true
        },
        {
          "serviceId": "azure-networking",
          "serviceName": "Networking (Public IP)",
          "resourceTypes": ["Microsoft.Network/publicIPAddresses"],
          "reason": "Public IP addresses are required if the VM needs to be accessible from the internet. Included in official samples like 'Block Resources by Type (Partial Lockdown)'. Only needed if the lab requires public connectivity.",
          "required": false
        },
        {
          "serviceId": "azure-storage",
          "serviceName": "Storage Accounts",
          "resourceTypes": ["Microsoft.Storage/storageAccounts"],
          "reason": "Storage accounts are required for VM diagnostic logs and boot diagnostics. Included as a supporting resource in official samples like 'Limit VM by Name, Size, and Location' and 'Restrict to VM Scale Sets'. Note: Storage Accounts are NOT the same as Managed Disks — managed disks are Azure-managed disk resources (Microsoft.Compute/disks), while storage accounts are used for diagnostics and unmanaged data.",
          "required": false
        }
      ]
    },
    {
      "id": "azure-compute-vmss",
