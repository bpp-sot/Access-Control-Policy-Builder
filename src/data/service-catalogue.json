    {
      "id": "azure-compute-vm",
      "name": "Virtual Machines",
      "category": "Compute",
      "resourceTypes": [
        "Microsoft.Compute/virtualMachines",
        "Microsoft.Compute/disks",
        "Microsoft.Compute/virtualMachines/extensions"
      ],
      "officialSampleAvailable": true,
      "officialSampleIds": [
        "azure-block-all-vms",
        "azure-block-by-type-partial",
        "azure-full-lockdown-type-name-sku",
        "azure-block-specific-vm-sizes",
        "azure-limit-vm-vmss-name-sku-region-capacity",
        "azure-limit-vm-name-size-location",
        "azure-limit-vm-sizes",
        "azure-require-resource-name"
      ],
      "riskCategory": "High",
      "costSensitivity": "High",
      "identitySensitivity": "Medium",
      "networkExposureSensitivity": "Medium",
      "notes": "VMs are the most abused resource by malicious users (e.g. bitcoin miners). Limit by SKU, Region, and Name for maximum security.",
      "dependencies": [
        {
          "serviceId": "azure-networking",
          "serviceName": "Networking",
          "resourceTypes": [
            "Microsoft.Network/virtualNetworks",
            "Microsoft.Network/networkInterfaces",
            "Microsoft.Network/networkSecurityGroups"
          ],
          "reason": "Azure VMs require a network interface (NIC), which in turn requires a virtual network (VNet) and typically a network security group (NSG). Without these, VM deployment will fail. All official Skillable VM samples include Microsoft.Network resources as supporting infrastructure.",
          "required": true
        },
        {
          "serviceId": "azure-networking",
          "serviceName": "Networking (Public IP)",
          "resourceTypes": ["Microsoft.Network/publicIPAddresses"],
          "reason": "Public IP addresses are required if the VM needs to be accessible from the internet. Included in official samples like 'Block Resources by Type (Partial Lockdown)'. Only needed if the lab requires public connectivity.",
          "required": false
        },
        {
          "serviceId": "azure-storage",
          "serviceName": "Storage Accounts",
          "resourceTypes": ["Microsoft.Storage/storageAccounts"],
          "reason": "Storage accounts are required for VM diagnostic logs and boot diagnostics. Included as a supporting resource in official samples like 'Limit VM by Name, Size, and Location' and 'Restrict to VM Scale Sets'.",
          "required": false
        }
      ]
    },
    {
