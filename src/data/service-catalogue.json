      "costSensitivity": "High",
      "identitySensitivity": "Medium",
      "networkExposureSensitivity": "Medium",
      "notes": "Scale sets can scale automatically. Consider limiting sku.capacity to prevent runaway costs.",
      "dependencies": [
        {
          "serviceId": "azure-networking",
