          "resourceTypes": ["Microsoft.Compute/disks"],
          "reason": "Azure automatically creates managed disks for each VMSS instance's OS disk when provisioning a scale set. Without this resource type in the policy whitelist, VMSS deployment will fail. This is native Azure platform behaviour, not a Skillable-specific rule.",
          "required": true,
          "autoIncluded": true,
          "evidenceClassification": "C"
        },
        {
          "serviceId": "azure-networking",
          "serviceName": "Networking",
          "resourceTypes": [
            "Microsoft.Network/virtualNetworks",
            "Microsoft.Network/networkInterfaces",
            "Microsoft.Network/networkSecurityGroups"
          ],
          "reason": "VM scale sets require a virtual network, network interfaces, and typically a network security group. The official 'Restrict to VM Scale Sets' sample includes Microsoft.Network resources as supporting infrastructure.",
          "required": true
        },
        {
          "serviceId": "azure-storage",
          "serviceName": "Storage Accounts",
          "resourceTypes": ["Microsoft.Storage/storageAccounts"],
          "reason": "Storage accounts are required for VMSS boot diagnostics and are included in the official 'Restrict to VM Scale Sets' sample.",
          "required": true
