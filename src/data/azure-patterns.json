    {
      "id": "azure-require-resource-name",
      "title": "Require Specific Resource Name",
      "reusablePattern": "require-naming-pattern",
      "purpose": "Define one or more approved names for resources. Users will be unable to create VMs without a certain naming convention.",
      "sourcePath": "access-control-policies/Azure/Require Specific Resource Name/policy.json",
      "sourceReadmePath": "access-control-policies/Azure/Require Specific Resource Name/readme.md",
      "githubUrl": "https://github.com/LearnOnDemandSystems/labauthor/tree/master/access-control-policies/Azure/Require%20Specific%20Resource%20Name",
      "evidenceClassification": "A",
      "servicesRepresented": ["compute"],
      "resourceTypesRepresented": ["Microsoft.Compute/virtualMachines/osprofile.computername"],
      "regionsOrLocationsMentioned": [],
      "sizesOrSkusMentioned": [],
      "wildcardUse": [],
      "policyJson": {
        "if": {
          "allOf": [
            {
              "not": {
                "field": "name",
                "match": "RJGVM-###"
              }
            },
            {
              "field": "type",
              "equals": "Microsoft.Compute/virtualMachines/osprofile.computername"
            }
          ]
        },
        "then": { "effect": "deny" }
      },
      "structureNotes": "Uses 'match' operator with pattern 'RJGVM-###' where # matches a digit. Targets VM computer name specifically.",
      "applicableWhen": "The lab requires VMs to follow a specific naming convention."
